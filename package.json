{
  "name": "@alxgrn/telefrag-editor",
  "description": "The Daily Telefrag Editor",
  "version": "0.0.94",
  "private": false,
  "author": "Alexander Fedorov <alex@molner.ru>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/alxgrn/telefrag-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alxgrn/telefrag-editor.git"
  },
  "bugs": {
    "url": "https://github.com/alxgrn/telefrag-editor/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/telefrag-editor.umd.js",
  "module": "./dist/telefrag-editor.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/telefrag-editor.es.js",
      "require": "./dist/telefrag-editor.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@alxgrn/telefrag-types": "^0.1.0",
    "@alxgrn/telefrag-ui": "^0.0.55",
    "@types/node": "^22.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.0.0-beta.2",
    "vite-plugin-lib-inject-css": "^2.1.1"
  },
  "dependencies": {
    "@alxgrn/prose-editor": "^0.0.50",
    "load-script": "^2.0.0",
    "quill": "^2.0.3",
    "quill-delta-to-html": "^0.12.1"
  }
}
